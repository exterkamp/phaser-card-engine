{
  "name": "phaser-card-engine",
  "version": "0.27.0",
  "description": "The shared half of two card games: card art, suits, ranks, deck themes, shuffling and the typefaces.",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "default": "./dist/phaser/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "src",
    "ATTRIBUTION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.spec.json",
    "demo": "vite",
    "demo:build": "vite build",
    "demo:serve": "vite preview",
    "smoke": "node tools/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "phaser": "^3.90.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exterkamp/phaser-card-engine.git"
  },
  "peerDependencies": {
    "phaser": "^3.80.0"
  },
  "peerDependenciesMeta": {
    "phaser": {
      "optional": true
    }
  }
}
