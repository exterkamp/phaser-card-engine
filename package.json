{
  "name": "phaser-card-engine",
  "version": "0.1.3",
  "description": "The shared half of two card games: card art, suits, ranks, deck themes, shuffling and the typefaces.",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "src",
    "ATTRIBUTION.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run typecheck && vitest run",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.spec.json"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exterkamp/phaser-card-engine.git"
  }
}
